# Review-only template for contracts/script/DeployParPool.s.sol. Copy to an ignored .env.par-pool and fill the entries
# the chosen STAGE needs. Addresses contain no signing material. Keep keystores and password files outside the
# repository. Every signing role must be a real account: the script rejects zero and virtual (TIP-1022) addresses.
# One account may hold every role for a small live test; split them before adding meaningful inventory.

# Required, one of:
#   pool        stage 1: oracle + pool owned by the deployer, optional funding, unpause. Prints POOL_ADDRESS.
#   controller  stage 2: controller for the existing POOL_ADDRESS, then pool ownership to the controller.
#   all         both stages in one run, only when liquidation addresses exist and oracle owner is the deployer.
STAGE=pool

# All stages. Sends every transaction and owns the pool until the controller accepts ownership.
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

# All stages. The pool's two TIP-20s and the symbol each must report. The script refuses a symbol mismatch, the same
# token twice, and tokens of unequal decimals: par swaps equal raw amounts each way. Stage 2 requires the existing
# pool to hold exactly this base and quote, in this order. Each token's own TIP-403 transfer policy applies, whatever
# its id: the deployer must be allowed to send what it funds, the pool to send and receive both tokens, and each
# liquidation address to receive its token.
BASE_TOKEN=0x0000000000000000000000000000000000000000
BASE_TOKEN_SYMBOL=
QUOTE_TOKEN=0x0000000000000000000000000000000000000000
QUOTE_TOKEN_SYMBOL=

# All stages require these expected PushPriceOracle roles. For controller, ownership must already be accepted,
# with no pending oracle owner and an exactly matching reporter. Use pool -> acceptOwnership() -> controller
# for an external owner; all rejects it before broadcasting. These two entries are read in every stage.
# The reporter must re-attest par, pushPrice(100000000, <now>), before MAX_ORACLE_AGE
# elapses, with a strictly later timestamp each time. The owner can replace the reporter.
ORACLE_OWNER_ADDRESS=0x0000000000000000000000000000000000000000
ORACLE_REPORTER_ADDRESS=0x0000000000000000000000000000000000000000

# ---- Stage 1 (pool) and all: read only when STAGE is pool or all ----
# Can pause the pool (which also blocks the keeper); cannot unpause or withdraw. Stage 2 keeps the pool's guardian.
GUARDIAN_ADDRESS=0x0000000000000000000000000000000000000000
# Seconds, 1..31536000 (365 days); blank means 2592000 (30 days). The par feed carries no market data, so this is
# a liveness heartbeat, not price protection: when it lapses, swaps, keeper rebalances and stage 2 revert until the
# reporter pushes again. Shorter = earlier fail-closed on an abandoned feed but more pushes.
MAX_ORACLE_AGE=2592000
# Basis points, 0..100; blank means 0. Both anchors are set to par at unpause. With 0, any off-par push halts swaps and
# keeper rebalances instead of moving the price; the Earn router accepts only exact par anyway.
MAX_PRICE_DEVIATION_BPS=0
# Raw units in the tokens' shared decimals, at most 1,000 whole tokens each; blank or 0 skips that side. With 6
# decimals, 10000000 = 10 tokens. The deployer must hold these balances and pay fees in another token.
INITIAL_BASE_AMOUNT=0
INITIAL_QUOTE_AMOUNT=0

# ---- Stage 2 (controller) and all: read only when STAGE is controller or all ----
# Printed by stage 1. Required for STAGE=controller and rejected otherwise. ORACLE_ADDRESS is optional and, when
# set, must be the pool's oracle.
POOL_ADDRESS=
# Required for controller only: the pool's creation block from stage 1's mined receipt. The RPC must return complete
# logs from this block; a missing constructor event, RPC failure or any surviving taker/recipient grant aborts.
POOL_DEPLOYMENT_BLOCK=
# Required for controller only: the pool CREATE transaction hash (not the oracle or unpause transaction).
# The active RPC must return its successful canonical receipt and exact creation input, including compiler metadata.
# Use the same source/dependencies/compiler settings as stage 1; keep its guardian, oracle and risk settings unchanged.
# Deploy using the protocol nonce, without --batch, --tempo.nonce-key, --tempo.lane or --tempo.expires.
POOL_CREATION_TX=
ORACLE_ADDRESS=
# Offline owner of DirectPropAMMRebalanceController: admits routers, withdraws, sets risk, rotates the keeper.
# When it equals DEPLOYER_ADDRESS, the controller accepts pool ownership in the same run; otherwise the script prints
# the execute(acceptOwnership()) call this account must send, and the deployer owns the pool until then.
CONTROLLER_OWNER_ADDRESS=0x0000000000000000000000000000000000000000
# Hot key that can only call controller.rebalance (pause, withdraw to a liquidation address, unpause).
KEEPER_ADDRESS=0x0000000000000000000000000000000000000000
# Fixed forever in the controller. Bridge liquidation addresses created with POOL_ADDRESS as destination_address:
# BASE takes the base token and pays the quote token to the pool, QUOTE takes the quote token and pays the base token
# to the pool. Must be nonzero, distinct and allowed by each token's transfer policy. Verify payout AND refund
# destinations with Bridge; the contract cannot.
BASE_LIQUIDATION_ADDRESS=
QUOTE_LIQUIDATION_ADDRESS=
# Optional: the Earn SingleZoneEarnRouter to admit later. Only prints the exact admission calldata; never executed.
EARN_ROUTER_ADDRESS=

TEMPO_RPC_URL=https://rpc.tempo.xyz
