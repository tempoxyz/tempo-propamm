# Review-only template. Copy to an ignored .env.usdce-pools and fill EVERY blank.
# Addresses contain no signing material. Keep keystores and password files outside the repository.
# Same final owner and guardian for both pools; deployer must differ from both.
DEPLOYER_ADDRESS=
OWNER_ADDRESS=
GUARDIAN_ADDRESS=

# Required seconds: positive for PRIME; >= 86400 for Ondo's daily USDY price.
# Choose PRIME freshness against its observation cadence; do not blindly copy USDY's window.
PRIME_MAX_ORACLE_AGE=
USDY_MAX_ORACLE_AGE=

# Required basis points, 0..10000 inclusive. 50 means +/-0.5%; these are guards, not spreads.
PRIME_MAX_PRICE_DEVIATION_BPS=
USDY_MAX_PRICE_DEVIATION_BPS=

TEMPO_RPC_URL=https://rpc.tempo.xyz
