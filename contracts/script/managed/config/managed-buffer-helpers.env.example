# Review-only template for contracts/script/managed/DeployManagedBufferHelpers.s.sol. Copy to an ignored
# .env.managed-buffer-helpers and fill every entry. Addresses contain no signing material. Keep keystores and password
# files outside the repository. Runs on chain 4217 or 42431 and deploys only DirectPropAMMBufferHelpers, which hold
# no tokens and have no authority: the pool's owner still admits each BoringVault, and the Veda authority still
# allows each helper and selects it on the Teller.

# Sends one CREATE per helper, in order. A real account: the script rejects zero and virtual (TIP-1022) addresses.
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
# The ManagedDirectPropAMM, with its pairs already added. A DirectPropAMM or a v2 Venue is refused.
POOL_ADDRESS=0x0000000000000000000000000000000000000000

# One comma-separated entry per helper, 1 to 16 helpers, never two for one vault and pair.
# The BoringVault itself, the account that swaps: never a Teller, an Earn engine or a deployment wallet.
HELPER_VAULTS=
# The pair whose base the vault holds and whose quote is its asset. Mined addPair order assigns indexes: read
# PairAdded and pair(index) from the chain, never an unreviewed position.
HELPER_PAIR_INDEXES=
# The reviewed tokens of each pair. The live pair must hold exactly these.
HELPER_EXPECTED_BASES=
HELPER_EXPECTED_QUOTES=
# The list that admits each vault on its pair: 0 for the pair's home list, else a registered sponsor's id.
HELPER_SPONSOR_IDS=
# Nonzero 32-byte route ids. Route credit is keyed by (pairIndex, taker, customerId) and starts at zero in a new pool.
HELPER_CUSTOMER_IDS=
# Quote tolerance, 0..1000 basis points each. Not a fee cap: the helper has none.
HELPER_SLIPPAGE_BPS=
# The helper each vault's Teller uses today, or the zero address for none. It must serve the same vault and tokens;
# a different customer id or slippage only warns.
HELPER_REFERENCES=

TEMPO_RPC_URL=https://rpc.tempo.xyz

# Resolve every WARNING the run prints before a Teller switches: a vault its pair does not admit yet, and a pair hook
# whose fee for the vault must be verified zero in both directions.
