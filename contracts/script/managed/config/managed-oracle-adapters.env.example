# Review-only template for contracts/script/managed/DeployManagedOracleAdapters.s.sol. Copy to an ignored
# .env.managed-oracle-adapters and fill every entry. Addresses contain no signing material. Keep keystores and password
# files outside the repository. Runs on chain 4217 or 42431 and deploys only immutable, ownerless price adapters.

# Sends one CREATE per adapter, in order. A real account: the script rejects zero and virtual (TIP-1022) addresses.
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000

# One entry per adapter, in the order DeployManagedPool's PAIR_ORACLES will name them, 1 to 16 adapters. A pool
# refuses an oracle address a second pair already uses, so two pairs on one feed need an entry each.
# CHAINLINK: ChainlinkPriceOracleAdapter, the feed's own decimals.
# CHAINLINK_18_TO_8: Chainlink18To8PriceOracleAdapter, an 18-decimal feed read at 8 decimals, rounded down.
# ONDO_USDY: OndoUSDYPriceOracleAdapter, Ondo's USDY oracle wrapper, 18 decimals.
# Example: a PRIME pair on the 18-decimal feed read at 8 decimals, and a USDY pair.
ORACLE_KINDS=CHAINLINK_18_TO_8,ONDO_USDY
# The Chainlink AggregatorV3 feed, or Ondo's wrapper (on mainnet only the canonical wrapper below).
ORACLE_SOURCES=0x0ae20Ebc56e1944eBaa7E40E65C8b7A61d6fF490,0xb25b3266467a755328cfb8F1b349319C2B94419C
# Separated by |. The feed's exact description(), reviewed with the feed's operator: it, not the decimals, says the
# feed prices the pair's base in its quote. Use - for ONDO_USDY, whose wrapper has none.
# Keep the single quotes: the value holds spaces and |, which a shell sourcing this file would otherwise run.
ORACLE_SOURCE_DESCRIPTIONS='HASTRAPRIME / WYLDS Exchange Rate|-'
# The decimals() each adapter must answer. A managed pair fixes its oracle's decimals when it is added, so this is
# the pair's price precision for good: CHAINLINK takes the feed's, CHAINLINK_18_TO_8 is 8, ONDO_USDY is 18.
ORACLE_DECIMALS=8,18
# Seconds, 1..31536000 each: the maxOracleAge planned for the pair. The source must hold a positive observation that
# fresh now, or nothing is deployed.
ORACLE_MAX_AGES=
# An existing IPriceOracle each new adapter must agree with now (same observation time, same price at the coarser
# precision), or the zero address for none. For a pair that replaces a live pool, read that pool's oracle() from the
# chain and name it here.
ORACLE_REFERENCES=0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000

TEMPO_RPC_URL=https://rpc.tempo.xyz

# After inclusion, read each adapter's feed() or wrapper(), decimals() and latestPrice() from the chain, then pass the
# printed PAIR_ORACLES line to DeployManagedPool in the same pair order.
