# Template for contracts/script/managed/DeployManagedOracleAdapters.s.sol. Copy to an ignored
# .env.managed-oracle-adapters. Runs on chain 4217 or 42431 and deploys only immutable, ownerless price adapters.

# One comma-separated entry per adapter, in the order DeployManagedPool's PAIR_ORACLES will name them.
# CHAINLINK: the feed's own decimals. CHAINLINK_18_TO_8: an 18-decimal feed read at 8 decimals.
# ONDO_USDY: Ondo's USDY oracle wrapper, 18 decimals.
ORACLE_KINDS=
# The Chainlink AggregatorV3 feed, or Ondo's wrapper. Confirm with the feed's operator that it prices the pair's
# base in the pair's quote: decimals are precision, not a currency conversion.
ORACLE_SOURCES=

# The account that sends, passed to Forge as --sender.
DEPLOYER_ADDRESS=
TEMPO_RPC_URL=
