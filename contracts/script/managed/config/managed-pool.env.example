# Review-only template for contracts/script/managed/DeployManagedPool.s.sol. Copy to an ignored .env.managed-pool and fill
# every entry. Addresses contain no signing material. Keep keystores and password files outside the repository.
# Every role must be a real account: the script rejects zero and virtual (TIP-1022) addresses. Run with
# --network tempo (Forge runs the pairs' TIP-20 precompiles only there) on chain 4217 or 42431.

# Sends the deployment, and on Moderato with OWNER_ADDRESS equal to it, every addPair. On mainnet it must hold no
# pool role: the script refuses it as OWNER_ADDRESS.
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
# The pool's owner, normally a Safe: adds pairs, registers sponsors, edits the home lists, lifts denials, opens pairs,
# funds, withdraws and unpauses. When it differs from the deployer, the script prints each addPair as Safe calldata
# for it to send. Mined addPair order assigns indexes; positions below are provisional, not reserved.
OWNER_ADDRESS=0x0000000000000000000000000000000000000000

# One comma-separated entry per pair, in simulated pair order (pair 0 first), 1 to 16 pairs. The same tokens may form
# several pairs, either way round, but never with the same oracle twice (the script refuses an oracle an earlier pair uses:
# the reversed pair would trade at the inverse price). Inventory is shared per token across pairs: a bad
# oracle on one pair can sell a token another pair needs, so keep tokens that back independent risk in separate pools.
# Example: PRIME/pathUSD.
PAIR_BASES=0x20C00000000000000000000058d0B8b2CFDb358c
PAIR_QUOTES=0x20C0000000000000000000000000000000000000
# Each an IPriceOracle (a PushPriceOracle or a ChainlinkPriceOracleAdapter, never a raw Chainlink aggregator) that
# answers decimals() and latestPrice(). A stale price only warns: opening the pair needs it fresh.
PAIR_ORACLES=
# Seconds, 1..31536000 (365 days) each.
PAIR_MAX_ORACLE_AGES=90000
# Basis points, 0..100 each: the directional anchor's deviation limit, a circuit breaker, not a spread.
PAIR_MAX_PRICE_DEVIATION_BPS=50

TEMPO_RPC_URL=https://rpc.tempo.xyz

# After inclusion, verify PairAdded and live pair(index). For ManagedPoolAccess pair modes, set the
# reviewed EXPECTED_BASE, EXPECTED_QUOTE and EXPECTED_ORACLE alongside PAIR_INDEX; never copy an
# unreviewed index's addresses as expectations. Re-simulate queued Safe calls before execution.
